<?xml version="1.0" encoding="utf-8"?>
<!-- Release overlay for Play builds only (-Pplay=true, see app/build.gradle.kts).
     Play refuses UPDATE_PACKAGES_WITHOUT_USER_ACTION, and a Play-distributed app may only
     update through Play, so the in-app installer's permissions are removed here too.
     UpdateActivity hides the GitHub and Shizuku install paths when BuildConfig.PLAY_BUILD. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission
        android:name="android.permission.UPDATE_PACKAGES_WITHOUT_USER_ACTION"
        tools:node="remove" />

    <uses-permission
        android:name="android.permission.REQUEST_INSTALL_PACKAGES"
        tools:node="remove" />

</manifest>
