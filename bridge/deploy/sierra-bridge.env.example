# /etc/sierra-bridge/env  (chmod 600, owned by the service user)
# The phone sends this as its API key. Make one with:
#   python3 -c 'import secrets; print(secrets.token_urlsafe(32))'
SIERRA_BRIDGE_TOKEN=replace-me

# Upstream keys named by api_key_env in bridge.toml. Leave out the ones you do not use.
#HERMES_API_KEY=
#LITELLM_KEY=

# Keys the CLI agents themselves need (the command and pi adapters inherit this environment).
#ANTHROPIC_API_KEY=
#OPENAI_API_KEY=
